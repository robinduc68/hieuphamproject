# ── Database ───────────────────────────────────────────────
POSTGRES_DB=huyvo_db
POSTGRES_USER=huyvo
POSTGRES_PASSWORD=huyvo_secret

# Host ports (set if defaults conflict with local services)
# POSTGRES_HOST_PORT=5434
# BACKEND_HOST_PORT=8001

# Full URL (auto-built in docker-compose, override for local dev)
DATABASE_URL=postgresql://huyvo:huyvo_secret@localhost:5434/huyvo_db

# ── App ────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days
ALGORITHM=HS256

# ── CORS ───────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Storage (dùng local hoặc S3) ──────────────────────────
MEDIA_DIR=./media
MAX_UPLOAD_SIZE_MB=10

# ── Email (tuỳ chọn) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@huyvo.com

# ── Environment ────────────────────────────────────────────
APP_ENV=development       # development | production
DEBUG=true
