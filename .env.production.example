# ── Database ───────────────────────────────────────────────
POSTGRES_DB=hahoat_db
POSTGRES_USER=hahoat
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Không cần POSTGRES_HOST_PORT trên production (port không expose)
DATABASE_URL=postgresql://hahoat:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/hahoat_db

# ── App ────────────────────────────────────────────────────
# Generate bằng: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_RUN_COMMAND_ABOVE

ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# ── CORS ───────────────────────────────────────────────────
# Thay bằng domain thật của mày
ALLOWED_ORIGINS=https://hahoatsilk.com,https://www.hahoatsilk.com

# ── Storage ────────────────────────────────────────────────
MEDIA_DIR=./media
MAX_UPLOAD_SIZE_MB=10

# Cloudflare R2 – điền ĐỦ 5 biến thì ảnh lưu lên R2, thiếu 1 cái là tự
# quay về lưu local disk (docker volume media_files) mà không báo lỗi.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Email ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@hahoatsilk.com

# ── VietQR (thanh toán chuyển khoản tự động) ───────────────
# Bỏ trống hết → web quay về chuyển khoản thủ công, không lỗi.
# Sandbox: https://dev.vietqr.org   Production: https://api.vietqr.org
VIETQR_BASE_URL=https://dev.vietqr.org

# VietQR cấp sau khi đăng ký merchant — để hệ thống gọi sang VietQR
VIETQR_USERNAME=
VIETQR_PASSWORD=

# Tài khoản nhận tiền, in trên mã QR (tên không dấu)
VIETQR_BANK_CODE=
VIETQR_BANK_ACCOUNT=
VIETQR_ACCOUNT_NAME=

# Tự đặt, rồi khai báo đúng 2 giá trị này cho VietQR trên cổng merchant —
# để VietQR gọi ngược về /api/bank/api/token_generate lấy token
VIETQR_CALLBACK_USERNAME=
VIETQR_CALLBACK_PASSWORD=

# ── Environment ────────────────────────────────────────────
APP_ENV=production
DEBUG=false
